# Required — get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — Claude model used for quiz generation and grading (default: claude-haiku-4-5)
# QUIZ_MODEL=claude-haiku-4-5

# Optional — enables GET /debug/session/{session_id} for inspecting session state (default: off)
# DEBUG=true
